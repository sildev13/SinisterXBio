# Copy this file to .env and fill in the real values.
# .env is gitignored – never commit real secrets.

# Password for protected pages/routes (see protectedRoutes in once-ui.config.ts)
PAGE_ACCESS_PASSWORD=

# Discord webhook that receives messages from the /contact page
# Create one in: Server Settings > Integrations > Webhooks
DISCORD_WEBHOOK_URL=

# Gemini API key for the AI assistant (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
